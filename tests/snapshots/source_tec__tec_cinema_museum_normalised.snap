  {
    "event": {
      "address": "2 Dugard Way, London SE11 4TH",
      "all_day": false,
      "category": "talk",
      "dedupe_key": "lisa-gornick-in-conversation-with-caroline-cassin|2026-10-24|cinema",
      "description": "Join British filmmaker, artist, and performer Lisa Gornick in conversation with curator Caroline Cassin. Celebrating Lisa’s 60th birthday, this special event will explore her expansive body of work, looking back on her filmmaking life as she embarks on a new feature film. Lisa’s career as a filmmaker spans three decades, during which they have made three feature films and seven short films. She is celebrated for the BFI-acclaimed Do I Love You? (2002), the first British lesbian feature film in a decade (below), Tick Tock Lullaby (2007), a comedy-drama about the ambivalence around whether to be a parent and The Book of Gabrielle (2016), their first cross-platform production about talking, writing and drawing sex. Caroline will explore with Lisa the very intimate, existential investigations that form the basis of her work. Made largely outside conventional production structures, their films have always been poignant, personal, comedic and defiantly DIY. The evening will weave together clips from Lisa’s films, an interactive live drawing performance, music and conversation. All proceeds from ticket sales will support two important crowdfunding campaigns: Lisa’s film and The Cinema Museum’s effort to secure its home. 5-6pm: Arrival and gathering to Lisa’s soundtrack Doors open at 5pm, when refreshments and snacks will be available in our licensed cafe/bar; you can browse the bookstore, all soundtracked by Lisa’s favourite tunes. 6-7.15pm: Lisa Gornick in Conversation with Caroline Cassin Lisa and Caroline explore a selection of Lisa’s chosen film clips and share stories about Lisa’s life as a filmmaker and the making of the films. 7.30-8pm: Live drawing performance Lisa takes to the drawing table for a live, interactive drawing session, bringing the evening’s conversation into the present and giving the audience a chance to participate. 8-9pm: Birthday celebrations More music and conversation. Maybe even dancing? After 9pm, for those who want to keep the party going, we’ll head to another venue.",
      "ends_at": "2026-10-24T18:30:00Z",
      "image_url": "https://cinemamuseum.org.uk/wp-content/uploads/2026/09/Lisa-Gornick.jpg",
      "lat": null,
      "lng": null,
      "price": {
        "currency": "GBP",
        "is_free": false,
        "max": "10",
        "min": "10"
      },
      "starts_at": "2026-10-24T16:00:00Z",
      "tags": [
        "events"
      ],
      "title": "Lisa Gornick in Conversation with Caroline Cassin",
      "url": "https://cinemamuseum.org.uk/scheduled/lisa-gornick-in-conversation-with-caroline-cassin/",
      "venue_name": "The Cinema Museum"
    },
    "id": "/scheduled/lisa-gornick-in-conversation-with-caroline-cassin/"
  },
