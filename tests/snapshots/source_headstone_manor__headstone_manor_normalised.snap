    "event": {
      "address": "Headstone Recreation Ground, Pinner View, Harrow HA2 6PX",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "history-of-roman-harrow|2026-09-15|headstone-manor",
      "description": "Join us on a journey through the landmarks of Roman Harrow. Meet the potters of Sulloniacae and spend the night at the roadside mutatio (service station), which may once have stood on Brockley Hill. Discover the skill and artistry behind the settlement's thriving pottery industry, from the craftspeople who shaped everyday vessels to the extensive trade networks that carried their wares across Roman Britain. Objects made here have been uncovered as far north as the famous Hadrian's Wall, revealing Harrow's important place in the Roman world and the remarkable legacy of its ancient communities.",
      "ends_at": "2027-01-03T00:00:00Z",
      "image_url": "https://harrow-arts.transforms.svdcdn.com/production/HMM/Exhibitions-Gallery/pots-archive-2.jpg?w=640&h=360&q=100&auto=format&fit=crop&dm=1786435536&s=2d885cca51d8f44e71e5f8c8f47f4809",
