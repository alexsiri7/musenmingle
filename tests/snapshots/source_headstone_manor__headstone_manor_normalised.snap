    "id": "exhibitions/harrow-unearthed-a-litter-legacy",
    "payload": {
      "description": "<p>Historic litter and curiosities found in Harrow by volunteers from Harrow Litter Pickers, an apolitical group of volunteers who litter pick, remove graffiti, organise events, and make Harrow a cleaner and brighter place. In 2025 volunteers gave 9,810 hours of time to clear 17,874 bags of rubbish from Harrow’s streets, parks and waterways.</p><p>Our finds include glass bottles and ceramic jars over a century old, drinks cans and plastic packaging dating back decades, and even local newspapers from the 1980s.&nbsp;</p><p>This display highlights the longevity of waste in the environment and showcases the work done in the borough of Harrow by our brilliant volunteers.</p>",
      "duration": null,
      "end": "2027-01-03T00:00:00+00:00",
      "genre": "Exhibitions",
      "image_url": "https://harrow-arts.transforms.svdcdn.com/production/HMM/Whats-On-Autumn-26/Harrow-Unearthed-A-Litter-Legacy.jpeg?w=640&h=360&q=100&auto=format&fit=crop&dm=1784626871&s=827a57ba45300c1b1de7409fe81f42eb",
      "path": "/exhibitions/harrow-unearthed-a-litter-legacy",
      "pre_title": null,
      "price_text": "FREE to view during usual opening hours",
      "room": "The Moat Cafe (Visitor's Cafe Case)",
      "start": "2026-09-02T00:00:00+01:00",
      "title": "Harrow Unearthed: A Litter Legacy",
      "url": "https://headstonemanor.org/exhibitions/harrow-unearthed-a-litter-legacy"
    }
  },
