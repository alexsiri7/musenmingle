  {
    "event": {
      "address": "Headstone Recreation Ground, Pinner View, Harrow HA2 6PX",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "harrow-unearthed-litter-legacy|2026-09-02|headstone-manor",
      "description": "Historic litter and curiosities found in Harrow by volunteers from Harrow Litter Pickers, an apolitical group of volunteers who litter pick, remove graffiti, organise events, and make Harrow a cleaner and brighter place. In 2025 volunteers gave 9,810 hours of time to clear 17,874 bags of rubbish from Harrow’s streets, parks and waterways. Our finds include glass bottles and ceramic jars over a century old, drinks cans and plastic packaging dating back decades, and even local newspapers from the 1980s. This display highlights the longevity of waste in the environment and showcases the work done in the borough of Harrow by our brilliant volunteers.",
      "ends_at": "2027-01-03T00:00:00Z",
      "image_url": "https://harrow-arts.transforms.svdcdn.com/production/HMM/Whats-On-Autumn-26/Harrow-Unearthed-A-Litter-Legacy.jpeg?w=640&h=360&q=100&auto=format&fit=crop&dm=1784626871&s=827a57ba45300c1b1de7409fe81f42eb",
