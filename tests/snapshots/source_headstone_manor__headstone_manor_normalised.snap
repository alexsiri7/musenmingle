    "event": {
      "address": "Headstone Recreation Ground, Pinner View, Harrow HA2 6PX",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "40-years-of-exhibitions-whats-next|2026-09-03|headstone-manor",
      "description": "Museums are built by communities, for communities. Since Headstone Manor Museum opened its doors 40 years ago, Harrow has grown into one of London's most diverse boroughs, and the museum has continued to evolve alongside it. This mini-exhibition explores how our exhibitions have changed over the decades, reflecting new ideas, voices and perspectives. Discover highlights from past displays, learn how community partnerships have shaped the stories we tell, and take a glimpse behind the scenes at exciting projects currently in development. Together, they demonstrate our ongoing commitment to preserving Harrow's heritage while ensuring everyone can see themselves reflected in the museum. Sponsored by The Friends of the Museum – Headstone Manor and Museum.",
      "ends_at": "2027-01-03T00:00:00Z",
      "image_url": "https://harrow-arts.transforms.svdcdn.com/production/HMM/Whats-On-Autumn-26/Mock-CC-icon-landscape.png?w=640&h=360&q=100&auto=format&fit=crop&dm=1784627744&s=5a300291bbdcf679a271420d2b0a6b6b",
