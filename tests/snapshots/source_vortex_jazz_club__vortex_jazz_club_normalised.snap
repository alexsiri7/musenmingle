  {
    "event": {
      "address": "11 Gillett Square, Dalston, London N16 8AZ",
      "all_day": false,
      "category": "music",
      "dedupe_key": "miles-spilsbury|2026-12-08|vortex-jazz-club",
      "description": "Doors 7:45 PM, Music 8:30 PM - 2 sets of music Line-up: Miles Spilsbury - Tenor saxophone, Soprano Saxophone, EWI, Flute, Electronics, Synthesiser, Sampling Harvey Grant - Synthesizer, Keytar, Electronics Rosie Turton - Modular Synthesiser Jake Long - Modified Drum Kit, Percussion Cam Dawson - Bass Guitar About Miles Spilsbury makes warm & expansive music, inspired by great improvising ensembles and drawing from fusion & new age worlds. His collaborators include Carlos Niño, Puma Blue, Nate Mercereau, Surya Botofasina & Gorse Panshawe as well as playing in The Physics House Band & Spirit Level. Following on from his debut album ‘Light Manoeuvres’ and recent release ‘Spirit Level’, the multi instrumentalist & composer presents new music and improvisations with a quintet. Spilsbury holds the two sometimes contrasting approaches of pure improvisation, and carefully constructed compositions and explores both without genre constraint. With influences ranging from Jon Hassell, Don Cherry, Billy Harper, Iasos & Art Ensemble Of Chicago, the group will explore textural improvisation with experimental instrumentation. [embed]https://www.youtube.com/watch?v=T2NUpYNI73s[/embed]",
      "ends_at": "2026-12-08T22:30:00Z",
      "image_url": "https://www.vortexjazz.co.uk/wp-content/uploads/2026/10/Miles-Spilsbury-.jpeg",
