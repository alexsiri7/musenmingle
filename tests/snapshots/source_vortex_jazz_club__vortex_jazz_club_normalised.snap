  },
  {
    "event": {
      "address": "11 Gillett Square, Dalston, London N16 8AZ",
      "all_day": false,
      "category": "music",
      "dedupe_key": "reiss-ellis-beckles-presents-blues-abstract-truth|2026-11-18|vortex-jazz-club",
      "description": "Doors 7:45 PM, Music 8:30 PM - 2 sets of music Line-up: Joseph Oti - Trumpet Reiss Ellis Beckles - Alto Saxophone Houston Patton - Tenor Saxophone Phil Knights - Baritone Saxophone Simon Purcell - Piano Tom Riviere - Double Bass Laura Klain - Drum Kit About: For one night only, saxophonist and bandleader Reiss Ellis Beckles presents a live performance of Oliver Nelson’s iconic The Blues and the Abstract Truth. Featuring Nelson’s original arrangements, the ensemble brings this landmark 1961 recording to life in its entirety — celebrating its powerful melodies, sophisticated harmonies and timeless blues language. A rare opportunity to experience one of jazz’s most influential albums performed live, as originally conceived.",
      "ends_at": "2026-11-18T22:30:00Z",
      "image_url": "https://www.vortexjazz.co.uk/wp-content/uploads/2024/09/Screenshot-2024-09-03-at-12.53.05.png",
