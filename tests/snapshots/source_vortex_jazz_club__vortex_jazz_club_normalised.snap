  {
    "event": {
      "address": "11 Gillett Square, Dalston, London N16 8AZ",
      "all_day": false,
      "category": "music",
      "dedupe_key": "mark-kavuma-quintet|2026-11-28|vortex-jazz-club",
      "description": "Doors 7:45 PM, Music 8:30 PM - 2 sets of music Line-up: Mark Kavuma - Trumpet Donavan Haffner - Alto saxophone Jack Thomas - Drums Ewan Hastie - Bass Deschanel Gordon - Piano About: This performance marks the debut of a brand-new quintet, presenting new compositions and a new musical direction, born from Mark Kavuma’s record label Banger Factory records. The quintet promises an evening of adventurous improvisation, compelling melodies and collective expression.",
      "ends_at": "2026-11-28T22:30:00Z",
