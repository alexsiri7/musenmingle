        "events",
        "talks"
      ],
      "title": "IN-HOUSE – Case by Case: Psychoanalysis and the Political Discourse | Book Launch with Patricia Gherovici & Jamieson Webster",
      "url": "https://www.freud.org.uk/event/in-house-case-by-case-psychoanalysis-and-the-political-discourse-book-launch-with-patricia-gherovici-jamieson-webster/",
      "venue_name": "Freud Museum London"
    },
    "id": "/event/in-house-case-by-case-psychoanalysis-and-the-political-discourse-book-launch-with-patricia-gherovici-jamieson-webster/"
  },
