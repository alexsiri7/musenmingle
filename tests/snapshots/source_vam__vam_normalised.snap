  {
    "date_text": "On now until Sunday, 28 February 2027",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "saodat-ismailova-melted-into-sun|2026-09-12|v-south-kensington",
      "description": "Saodat Ismailova's work explores the relationships between memory, perception, mythology, and the moving image. Drawing on the intellectual and oral traditions of Central Asia, she investigates how different forms of knowledge are transmitted, transformed, and contested across time. Melted Into the Sun is inspired by the enigmatic figure of Al-Muqannaʿ (‘The Veiled One’), an eighth-century mystic and political rebel from southern Central Asia. His legacy is marked by conflicting interpretations: celebrated by Soviet historians as a proto-socialist revolutionary, yet remembered in many Islamic traditions as an impostor. The film traces the echoes of his presence through landscapes associated with his life and legend. According to legend, Al-Muqannaʿ concealed a light so intense that it would blind anyone who looked upon it. Ismailova transforms the veil into a meditation on the instability of truth, exploring how myths, histories, and images continually shape—and reshape—our understanding of reality.",
      "ends_at": "2027-02-28T00:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/07/14/16/09/42/d024dc51-2e72-4a74-9129-323160c7c9be/saodat-ismailova-melted-into-the-sun_320.jpg",
      "lat": 51.4966,
      "lng": -0.1722,
      "price": {
        "currency": "GBP",
        "is_free": true,
        "max": "0",
        "min": "0"
