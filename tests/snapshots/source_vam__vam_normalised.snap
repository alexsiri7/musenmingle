      ],
      "title": "Emerging Designer Commission: Playfool The Server",
      "url": "https://www.vam.ac.uk/event/GyBvKmY9gL/ldf-sept-2026-emerging-designer-commission",
      "venue_name": "V&A South Kensington"
    },
    "id": "event/GyBvKmY9gL/ldf-sept-2026-emerging-designer-commission",
