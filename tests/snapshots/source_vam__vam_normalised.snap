    "venue": "V&A South Kensington"
  },
  {
    "date_text": "On now until Sunday, 18 October 2026",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "emerging-designer-commission-playfool-server|2026-09-12|v-south-kensington",
      "description": "Our online lives unfold as a constant stream of stimulation. Behind the restlessness lies a quiet physical infrastructure. Data centres keep our world running, and the AI race has accelerated their construction. In UK alone, nearly 100 new facilities are reportedly planned for completion in 2030. Highly automated, Playfool zeroes in on the one task in these places that resists automation: cleaning. Through alternative game design approaches, Playfool encourages visitors to explore the physical upkeep that sustains both the museum collections and the AI infrastructure, reflecting on what has been overlooked in the pursuit of progress. Visitors are invited to participate in the act of maintenance and care. Co-founded by Daniel Coppen and Saki Maruyama, Playfool is the recipient of V&A’s annual Emerging Design Commission. Their practice explores the transforming dynamic between human agency and technology through the medium of play, inviting critical reimagination of technology. The new commission was curated by Carrie Chan and produced by Katya Spiers. Part of V&A x LDF 2026 #LDF26",
      "ends_at": "2026-10-17T23:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/08/20/12/45/11/5bb96100-86c4-40a4-891a-742cc20cf313/emerging-designer-commission-playfool-the-server_320.jpg",
      "lat": 51.4966,
      "lng": -0.1722,
      "price": {
        "currency": "GBP",
        "is_free": true,
        "max": "0",
        "min": "0"
      },
      "starts_at": "2026-09-11T23:00:00Z",
      "tags": [
