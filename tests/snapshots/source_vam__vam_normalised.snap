      ],
      "title": "The World of Costume Design: Careers, Craft and Collaboration",
      "url": "https://www.vam.ac.uk/event/vqDb3EY1O2e/sandy-powell-and-annie-symons",
      "venue_name": "V&A South Kensington"
    },
