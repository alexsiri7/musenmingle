    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "v-illustration-awards-2026|2026-07-02|v-south-kensington",
      "description": "The V&A Illustration Awards is a free, biennial competition celebrating excellence in illustration and contemporary practice, and judged by a panel of prominent illustrators and industry experts. The awards highlight a broad range of illustration styles and subjects. This display features the work of this year's winners and runners-up from each of the five categories: Adult Factual, Adult Fiction, Advertising and Commercial, Emerging Illustrator and Illustration for Children. The Awards are generously supported by The Linder Foundation and the Moira Gemmill Memorial fund.",
