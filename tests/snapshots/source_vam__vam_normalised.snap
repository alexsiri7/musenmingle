  {
    "date_text": "On now until Sunday, 18 October 2026",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "andre-williams-time-after-time|2026-09-12|v-south-kensington",
      "description": "Time After Time by Andre Williams fuses the traditions of clockmaking and soundsystem design. Williams’ longcase clock sits on the zigzag parquet floor of the unique 18th century mirrored room in the V&A’s Europe 1600-1800 galleries. In this gilded, oval room, time is marked by the hands of the clock and audible through encased speakers playing mixtapes selected by Williams throughout the day. Decorated with motifs from Ndebele (Southern Africa) and Bamiléké (Cameroon) the clock is accompanied by an easel designed by Williams, which holds a framed drawing by artist Dawn Wilson of Birmingham Soundsystem Youthman Promotion. Curated by Kristian Volsing. Produced by Faunsia Tucker. Part of V&A x LDF 2026 #LDF26",
      "ends_at": "2026-10-17T23:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/08/19/12/51/33/4dceabc5-f856-4260-9459-4f05e30ef35c/andre-williams-time-after-time_320.jpg",
