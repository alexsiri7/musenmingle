  {
    "date_text": "On now until Sunday, 18 October 2026",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "sam-ghantous-your-golf-course-made-my-gpu|2026-09-12|v-south-kensington",
      "description": "The installation considers sand as the substrate onto which societies repeatedly project their desires and aspirations for progress. Works in the show draw together imagery and material products that capture the travel and state changes of sand. The microchip industry, artificial islands, and quartz crystals implicate computing with earthly transformation. By reconnecting digital technologies to their geological origins, the project asks how visions of progress become embedded in matter, and how the futures we imagine remain inseparable from the earth that makes them possible. Curated by Kristian Volsing. Produced by Katya Spiers. Part of V&A x LDF 2026 #LDF26",
      "ends_at": "2026-10-17T23:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/08/17/14/44/08/bdcbdb04-9a5c-4321-8815-084c927b94e6/ldf-sept-2026-sam-ghantous_320.jpg",
