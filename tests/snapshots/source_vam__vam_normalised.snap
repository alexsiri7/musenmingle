  },
  {
    "date_text": "On now until Sunday, 18 October 2026",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "eunjo-lee-when-void-gazes-back|2026-09-12|v-south-kensington",
      "description": "By fusing ancient heritage with contemporary technology, the installation asks questions about our relationship with non-human consciousness and spiritual truths Through a digitally sculpted film, Lee delves into concepts of Zen, karma andimpermanence rooted in Buddhism, reframing digital, shamanistic deities as ever-changing cosmic worlds within themselves. The deities also come alive as sculptures that are partially 3D printed from recycled clay. They are embedded with interactive design elements that invite audiences into an interactive and reflective dialogue. Eunjo Lee, an artist and filmmaker based in London and Seoul, is known for utilising gaming-graphics software to build complex worlds. Artistic collaborators include Josef Stöger (Digital Ceramics), Kiryung Arrddon Nam (Interactive Development), Gunho Hyun (Music), Harry Charlton (Sound Design), Steph Hartop (Voiceover) Curated by Carrie Chan. Produced by Faunsia Tucker Part of V&A x LDF 2026 #LDF26",
      "ends_at": "2026-10-17T23:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/08/24/08/08/53/2e4d7a78-f7ad-4446-b4b8-8ccdd8804270/eunjo-lee-when-the-void-gazes-back_320.jpg",
