  {
    "date_text": "On now until Sunday, 18 October 2026",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "henry-svendsen-lovers-hold|2026-09-12|v-south-kensington",
      "description": "Drawing on furniture designed for closeness, such as the loveseat, a series of viscous, grotto-like forms are suspended around stainless steel armatures, supporting multiple bodies in states of repose. Evoking the improvised and temporary nature of outdoor cruising sites, the sculptures materialise fleeting moments of contact, appearing as accumulated traces of desire. The work considers how bodies gather through structures not originally designed to hold them, and what it means to rest, lean, linger, and make contact in public space. Curated by Kristian Volsing. Produced by Katya Spiers. Part of V&A x LDF 2026 #LDF26",
      "ends_at": "2026-10-17T23:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/08/19/12/04/18/2effcc25-3d8f-4fe6-8e3c-5c8638b26fca/henry-svendsen-lovers-hold_320.jpg",
