  {
    "date_text": "Saturday, 3 October 2026",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": false,
      "category": "talk",
      "dedupe_key": "objects-of-fashion-unravelling-stories-in-person|2026-10-03|v-south-kensington",
      "description": "Join us as we explore Objects of fashion that hold poignant traces of makers and wearers. Unravelling these embodied clues can reveal stories of the past, provide inspiration for creative works, and generate new knowledge. Clothing and accessories like gloves, hats, or shoes are some of the most intimate and compelling of all objects of material culture because of their close connection to the body. Poignant traces of the makers and wearers embodied in objects of dress carry information from the past that might otherwise be inaccessible from written accounts. With careful study, patience, creativity and imagination, these clues can be unravelled to tell stories of the past, provide inspiration for creative works, and generate new knowledge. During this study day, we will discuss new developments in the field as well as the joys and challenges of object-based research. Not able to join us in person? You can also attend the study day online. This study day will not be recorded. For more details on how our courses work, see V&A Academy online questions · V&A. This course is suitable for participants aged 18 and over.",
      "ends_at": "2026-10-03T15:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/06/18/11/18/59/77dfaaf5-eb43-48a8-aff7-f25f538250d8/objects-of-fashion-unravelling-stories-in-person_320.jpg",
      "lat": 51.4966,
      "lng": -0.1722,
      "price": {
        "currency": "GBP",
        "is_free": false,
        "max": "100",
        "min": "100"
      },
      "starts_at": "2026-10-03T09:30:00Z",
      "tags": [
