  {
    "date_text": "On now until Sunday, 18 October 2026",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "nina-davies-image-syncers|2026-09-12|v-south-kensington",
      "description": "The artist examines a near future where images no longer depict the world. Grounded in viral TikTok trends where users mimic uncanny AI-generated dances, the work considers how people can adapt themselves to computational aesthetics. Presented as an episode of a fictional podcast, the central video essay charts a mysterious collective attempting to physically transform themselves into AI-generated figures. Holographic forms appear as spectral stand-ins for the film’s characters, while surrounding vitrines display their personal belongings, smartphones, and analogue props such as costume and makeup used in their transformation process. Curated by Carrie Chan and produced by Faunsia Tucker. Part of V&A x LDF 2026 #LDF26",
      "ends_at": "2026-10-17T23:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/08/18/16/52/34/d6b7ad7e-b665-4f48-acbb-38f0c1a6cb92/nina-davies-image-syncers_320.jpg",
