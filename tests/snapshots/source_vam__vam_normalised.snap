  {
    "date_text": "Thursday, 1 October 2026",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": false,
      "category": "talk",
      "dedupe_key": "lunchtime-lectures-bringing-design-1900-now-up-to-now|2026-10-01|v-south-kensington",
      "description": "Design 1900–Now gallery showcases around 250 objects from the V&A's collections of 20th- and 21st-century design. From the everyday to the provocative, the gallery explores and interrogates how design shapes our lives and vice versa, reflecting our past, present and future through objects we create and use across the globe. It also hosts the Rapid Response Collecting display, which invites staff and the public to suggest contemporary items for the museum’s collection while they remain part of active public discourse. Five years after the gallery’s opening in 2021, the curatorial team undertook substantial rotation in February 2026, introducing 60 new objects to keep abreast with recent technological and societal changes, while responding to conservation needs and feedback from visitors and peers. Join Anna Bates (Curator, Furniture and Product Design, 1900–Now) and William Seung (Assistant Curator, Design and Digital) as they discuss this recent update and reflect on the learnings and challenges that have emerged from maintaining a contemporary design gallery’s relevance in a rapidly changing world. If you would like to learn more with V&A Academy, please sign up to our V&A Academy Newsletter to be updated on future courses and events.",
      "ends_at": "2026-10-01T13:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/09/18/13/21/43/878a86c1-e4f4-4c4b-a862-7acf68a836c9/lunchtime-lectures-bringing-design-1900-now-up-to-now_320.jpg",
      "lat": 51.4966,
      "lng": -0.1722,
      "price": {
        "currency": "GBP",
        "is_free": true,
        "max": "0",
        "min": "0"
