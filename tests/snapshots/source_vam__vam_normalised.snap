  {
    "date_text": "On now until Sunday, 18 October 2026",
    "event": {
      "address": "Cromwell Road, London SW7 2RL",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "linda-dounia-once-upon-garden|2026-09-12|v-south-kensington",
      "description": "This work is a speculative archive of critically endangered and extinct flora that we have little to no records of, and therefore no way to remember. The artist uses AI as a time machine to piece together visual data about flowers we didn’t bother recording using sparse and fragmented available records. This final chapter of Dounia’s Once Upon A Garden project presents 50 emergent species of speculative flora made using image-to-image technology, tracing generative AI model evolution over time. The resulting flowers expose how AI models rely on mediated data and are made possible by machinery built with natural resources. During Digital Design Weekend (18-20 September), join a drop-in activity inspired by the artist's speculative flora and use collage to imagine a new flower shaped by memory, nature and imagination. Curated by Laura Herman and Marc Barto, produced by Nick Murray. Part of V&A x LDF 2026 #LDF26",
      "ends_at": "2026-10-17T23:00:00Z",
      "image_url": "https://assets-cdn.vam.ac.uk/2026/07/31/16/35/06/05855b95-fa3b-496d-9a7a-b782ccbaacc7/once-upon-a-garden-display-by-linda-dounia-rebeiz_320.jpg",
      "lat": 51.4966,
      "lng": -0.1722,
      "price": {
        "currency": "GBP",
        "is_free": true,
        "max": "0",
        "min": "0"
      },
      "starts_at": "2026-09-11T23:00:00Z",
