  {
    "source_event_id": "28225",
    "source_url": "https://ibraaz.org/whats-on/eden-at-dawn",
    "payload": {
      "categories": [
        {
          "slug": "talks",
          "title": "Talk"
        }
      ],
      "datesText": {
        "html": "<p>Wed 4 Nov, 6–8pm</p>"
      },
      "description": "<p style=\"margin-left:0px;\">Palestinian writers <strong>Karim Kattan</strong> and <strong>Tareq Baconi</strong> come together to discuss Kattan’s new novel <i>Eden at Dawn</i>, a sweeping queer love story which begins in Jerusalem and develops past the oppressive weight of occupation.</p><p style=\"margin-left:0px;\">Two men cross paths in the labyrinthine old city, where for centuries storytelling has fuelled romance. As a sandstorm covers the land, Gabriel and Isaac fall in love, lose each other, and find each other again. Despite extreme conditions, the lovers embark on a journey across Jericho to the West Bank, a daring act in a divided land.</p><p style=\"margin-left:0px;\">After <i>The Palace on the Higher Hill</i>, his first novel to be published in the UK, Kattan returns to the vivid Palestine of his imagination. Mixing traditional orality with classical culture and the marvellous with the tragically real, this story is a lyrical and shattering cry for love through which its author establishes himself as a master storyteller and takes us deeper into his literary world.</p><p style=\"margin-left:0px;\"><strong>Doors open at 5.30pm; event starts at 6pm and ends at 8pm.</strong> </p><p style=\"margin-left:0px;\">This even has been supported by the Institut Français.</p><p>Image credit: David Mclenachan on Unsplash.</p>",
      "endDate": "2026-11-04T20:00:00+00:00",
      "heading": "Karim Kattan with Tareq Baconi",
      "id": 28225,
      "image_url": "https://ibraaz-website.imgix.net/eden-at-dawn/952010b0-3696-482f-88b7-81cc7753d9e1.jpeg",
      "location": "Minassa",
      "slug": "eden-at-dawn",
      "startDate": "2026-11-04T18:00:00+00:00",
      "title": "Eden at Dawn",
      "url": "https://ibraaz.org/whats-on/eden-at-dawn"
    }
  }
