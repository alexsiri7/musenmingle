  {
    "source_event_id": "28051",
    "source_url": "https://ibraaz.org/whats-on/elegy-gabrielle-goliath",
    "payload": {
      "categories": [
        {
          "slug": "exhibitions",
          "title": "Exhibition"
        }
      ],
      "datesText": {
        "html": "<p>8 Oct 2026 - 17 Jan 2027</p>"
      },
      "description": "<p style=\"margin-left:0cm;\">Developed over more than a decade as a ritual performance and installation project, Gabrielle Goliath’s <i>Elegy</i> (2015–ongoing) gathers collective acts of mourning around lives and histories marked by violence, erasure and structural loss. </p><p style=\"margin-left:0cm;\"><i>Elegy</i> has evolved through multiple geographies and communities, with performative encounters staged across Johannesburg, Cape Town, São Paulo, Paris, Amsterdam, Munich and beyond. </p><p style=\"margin-left:0cm;\">The work arrives in London for a major institutional presentation, following the shocking cancellation of the South African Pavilion in Venice and its subsequent presentation as an independent exhibition at Chiesa di Sant’Antonin, with the support of Ibraaz, the Bertha Foundation and other allies.  </p><p style=\"margin-left:0cm;\">Installed in the sonic chamber of Ibraaz's Minassa, voices and moving images immerse audiences within a space of mourning, kinship and collective care. Addressing contexts of rape culture and femicide in South Africa, the genocide of Ovaherero and Nama peoples in Namibia and the ongoing devastation of Palestinian life, <i>Elegy</i> proposes mourning not as closure, but as a sustained practice of collective presence. </p>",
      "endDate": "2027-01-17T23:59:59+00:00",
      "heading": "Gabrielle Goliath",
      "id": 28051,
      "image_url": "https://ibraaz-website.imgix.net/28051/Elegy_Joan-Thabeng_Do-Disturb-Festival-Palais-de-Tokyo-Gabrielle-Goliath-Crédits-Ayka-Lux-3_2026-09-04-140714_glqr.jpg",
      "location": "Minassa",
      "slug": "elegy-gabrielle-goliath",
      "startDate": "2026-10-08T00:00:00+00:00",
      "title": "Elegy",
      "url": "https://ibraaz.org/whats-on/elegy-gabrielle-goliath"
    }
  },
