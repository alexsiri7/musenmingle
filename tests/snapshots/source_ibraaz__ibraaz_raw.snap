  {
    "source_event_id": "25673",
    "source_url": "https://ibraaz.org/whats-on/taring-padi",
    "payload": {
      "categories": [
        {
          "slug": "exhibitions",
          "title": "Exhibition"
        }
      ],
      "datesText": {
        "html": "<p>8 Jul – 22 Nov 2026</p>"
      },
      "description": "<p style=\"margin-left:0px;\">Ibraaz presents an exhibition by Taring Padi, an Indonesian collective of art workers founded in Yogyakarta in 1998 by a group of progressive art students and activists.&nbsp;</p><p style=\"margin-left:0px;\"><i>Rakyat Pasti Menang</i>, Bahasa Indonesia for ‘the people united will never be defeated’, brings together major works and archival material from the collective’s nearly thirty-year history. &nbsp;</p><p style=\"margin-left:0px;\">The exhibition takes its title from the protest chants heard&nbsp;during the sociopolitical upheaval of Indonesia’s Reformasi movement in the&nbsp;late 1990s. Rooted in the historical moment from which&nbsp;Taring Padi emerged, the phrase continues to resonate today, demonstrating how the collective has carried its spirit of solidarity and resistance into new political and cultural contexts.&nbsp;</p><p style=\"margin-left:0px;\">The show unfolds over three chapters, featuring Taring Padi’s large-scale banners, cardboard puppets, woodcut prints and posters. Alongside these presentations, a public programme of workshops, talks and activations, will explore their approach to art as a tool for political education, mobilisation, and collective struggle.&nbsp;</p><p style=\"margin-left:0px;\">Hosted in the Majlis, a space central to Ibraaz’s vision of dialogue and exchange, <i>Rakyat Pasti Menang</i> reflects a shared commitment to culture as a site of collective imagination and social transformation.&nbsp;</p>",
      "endDate": "2026-11-22T18:00:00+00:00",
      "heading": "Taring Padi",
      "id": 25673,
      "image_url": "https://ibraaz-website.imgix.net/25673/white-bground.png",
      "location": "Majlis",
      "slug": "taring-padi",
      "startDate": "2026-07-08T11:00:00+00:00",
      "title": "Rakyat Pasti Menang",
      "url": "https://ibraaz.org/whats-on/taring-padi"
    }
  },
