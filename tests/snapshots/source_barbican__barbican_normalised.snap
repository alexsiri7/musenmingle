  {
    "event": null,
    "id": "2027/robert-ryman-exhibition-tour-with-curatorial-assistant",
    "payload": {
      "art_forms": [
        "art-design"
      ],
      "date_text": "Fri 15 Jan 2027, 18:30",
      "description": "\n  <p><span>Join Curatorial Assistant Amber Li as she shares personal highlights from the exhibition and offers insights into Robert Ryman’s life and work.</span></p>\n\n<p><span>The Real Thing is the first major UK exhibition of Robert Ryman's paintings in over 30 years. Emerging as an artist in New York in the mid-1950s, Ryman approached every painting as a test to ‘see what would happen’, discovering that ‘there is never a question of what to paint, but only how to paint.’ For almost six decades, Ryman mainly used white paint and a square format to test materials and their effects, producing a remarkable variety of paintings that affirm materials as they are and ask us to pay attention to subtlety and nuance.</span></p><p><span>Presenting over 60 works from the mid-1950s to the early 2010s, this exhibition celebrates an artist who believed the poetry of painting was in feeling, and that painting was best understood though real, in-person experience:&nbsp;‘the real thing…was the only way to do it.’</span></p>",
      "ends": null,
      "image_url": "https://www.barbican.org.uk/sites/default/files/styles/large/public/images/2026-01/Untitled%20design%20%287%29.png.avif?itok=Pjua5dnG",
      "price_text": "£20.50 (£19 + £1.50 transaction fee)",
      "room": "Art Gallery",
      "starts": "2027-01-15T18:30:00Z",
      "subtitle": "Robert Ryman: The Real Thing",
      "title": "Exhibition Tour with Curatorial Assistant Amber Li",
      "url": "https://www.barbican.org.uk/whats-on/2027/event/robert-ryman-exhibition-tour-with-curatorial-assistant"
    }
  }
