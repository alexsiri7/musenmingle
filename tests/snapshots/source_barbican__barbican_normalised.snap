        "art-design",
        "talks-events"
      ],
      "title": "Walters and Cohen",
      "url": "https://www.barbican.org.uk/whats-on/2026/event/architecture-on-stage-walters-and-cohen",
      "venue_name": "Barbican Centre"
    },
    "id": "2026/architecture-on-stage-walters-and-cohen",
    "payload": {
      "art_forms": [
