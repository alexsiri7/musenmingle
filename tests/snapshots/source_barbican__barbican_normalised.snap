  {
    "event": {
      "address": "Silk Street, London EC2Y 8DS",
      "all_day": false,
      "category": "talk",
      "dedupe_key": "darbar-two-gharanas-one-musician-shahbaz-hussain-talk|2026-10-31|barbican",
      "description": "How three legendary gurus shaped one of Europe's finest tabla players. Shahbaz Hussain started learning tabla at five, taught by his father, the vocalist Ustad Mumtaz Hussain. He then went on to be taught by Ustad Faiyaz Khan of the Delhi gharana, Ustad Shaukat Hussain Khan of the Punjab gharana, and finally Ustad Allah Rakha — the man behind Ravi Shankar's rhythm section for decades. That dual training shows in how Hussain plays. He's accompanied Pandit Hariprasad Chaurasia, Ustad Shahid Parvez, and Ghulam Ali. He leads the fusion group Indus. He teaches across Northern England, and he believes that audiences benefit from understanding how tabla works: what a gharana is, how rhythm operates in Hindustani music and why different schools produce different sounds. In this talk, Hussain shares the stories, lessons and musical thinking he's gathered across three decades of performance and teaching.",
      "ends_at": null,
      "image_url": "https://www.barbican.org.uk/sites/default/files/styles/event_listing_small_jpg/public/images/2026-02/Shahbaz%20Hussain%20Talk%20Cover%20Image.jpg?h=4ac06099&itok=STj51jY6",
      "lat": 51.5201,
      "lng": -0.0955,
      "price": {
        "currency": "GBP",
        "is_free": false,
        "max": "24",
        "min": "24"
      },
      "starts_at": "2026-10-31T11:00:00Z",
      "tags": [
        "classical-music",
        "talks-events",
        "contemporary-music"
      ],
      "title": "Darbar: Two Gharanas, One Musician — Shahbaz Hussain (Talk)",
      "url": "https://www.barbican.org.uk/whats-on/2026/event/darbar-two-gharanas-one-musician-shahbaz-hussain-talk",
      "venue_name": "Barbican Centre"
    },
    "id": "2026/darbar-two-gharanas-one-musician-shahbaz-hussain-talk",
    "payload": {
      "art_forms": [
        "classical-music",
        "talks-events",
        "contemporary-music"
      ],
      "date_text": "Sat 31 Oct 2026, 11:00",
      "description": "\n  <p>How three legendary gurus shaped one of Europe's finest tabla players.</p>\n\n<p>Shahbaz Hussain started learning tabla at five, taught by his father, the vocalist Ustad Mumtaz Hussain. He then went on to be taught by Ustad Faiyaz Khan of the Delhi gharana, Ustad Shaukat Hussain Khan of the Punjab gharana, and finally Ustad Allah Rakha — the man behind Ravi Shankar's rhythm section for decades.</p><p>That dual training shows in how Hussain plays. He's accompanied Pandit Hariprasad Chaurasia, Ustad Shahid Parvez, and Ghulam Ali. He leads the fusion group Indus. He teaches across Northern England, and he believes that audiences benefit from understanding how tabla works: what a gharana is, how rhythm operates in Hindustani music and why different schools produce different sounds.</p><p>In this talk, Hussain shares the stories, lessons and musical thinking he's gathered across three decades of performance and teaching. &nbsp;</p>",
      "ends": null,
      "image_url": "https://www.barbican.org.uk/sites/default/files/styles/event_listing_small_jpg/public/images/2026-02/Shahbaz%20Hussain%20Talk%20Cover%20Image.jpg?h=4ac06099&itok=STj51jY6",
      "listing_title": "Darbar: Two Gharanas, One Musician — Shahbaz Hussain (Talk)",
      "price_text": "£24 (£20 + £4 transaction fee)",
      "room": "Frobisher Auditorium 1",
      "series": [
        "darbar-festival-2026"
      ],
      "starts": "2026-10-31T11:00:00Z",
      "subtitle": "Darbar Festival 2026",
      "title": "Two Gharanas, One Musician - Shahbaz Hussain (Talk)",
      "url": "https://www.barbican.org.uk/whats-on/2026/event/darbar-two-gharanas-one-musician-shahbaz-hussain-talk"
    }
