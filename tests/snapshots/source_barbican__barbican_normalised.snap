      ],
      "title": "Zifzafa",
      "url": "https://www.barbican.org.uk/whats-on/2026/event/lawrence-abu-hamdan-zifzafa",
      "venue_name": "Barbican Centre"
    },
    "id": "2026/lawrence-abu-hamdan-zifzafa",
