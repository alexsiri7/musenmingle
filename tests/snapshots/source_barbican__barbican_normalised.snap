  {
    "event": {
      "address": "Silk Street, London EC2Y 8DS",
      "all_day": false,
      "category": "exhibition",
      "dedupe_key": "lawrence-abu-hamdan-zifzafa|2026-09-23|barbican",
      "description": "This free exhibition presents video works by Lawrence Abu Hamdan that address how sound can both sustain and disrupt the richness of community life. A video installation explores the effect of a planned wind turbine development on the inhabitants of the Israeli-occupied Syrian Golan Heights. Zifzafa: Livestream Audio Essay (2025) presents a video-game simulation designed by Earshot to fight green colonialism. Adopting a Twitch-inspired format, the work guides viewers through a virtual recreation of the region. Field recordings of the resident Jawlani community—from wedding announcements to whirring water pumps— are periodically overwhelmed by the roar of simulated wind turbines, demonstrating how their impact would effectively silence the buzz of daily life. Wind Ensemble (2024), focuses on a performance by Jawlani saxophonist Amr Mdah. Played from the balcony of a home located just 50 metres from the site of a proposed wind turbine, his music becomes an act of sonic resistance.",
      "ends_at": "2026-09-26T19:00:00Z",
      "image_url": "https://www.barbican.org.uk/sites/default/files/styles/event_listing_small_jpg/public/images/2026-09/Zifzafa_%20livestream%20audio%20essay%2C%202025.%20Video%20game%20simulation%2C%204%20channel%20audio.jpg?itok=U0YDCGkR",
