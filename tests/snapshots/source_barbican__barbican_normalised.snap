  {
    "event": {
      "address": "Silk Street, London EC2Y 8DS",
      "all_day": false,
      "category": "music",
      "dedupe_key": "jaga-jazzist|2026-11-19|barbican",
      "description": "The Norwegian eight-piece bring four decades of restless experimentation to the EFG London Jazz Festival, where jazz, post-rock, psychedelia and electronic music converge. Founded in Norway in 1994 by the Horntveth siblings, Jaga Jazzist have spent four decades resisting genre orthodoxy. Led compositionally by Lars Horntveth, the eight-piece has developed a language spanning jazz, electronica, post-rock, psychedelia and cinematic composition, while retaining a fundamentally collaborative approach. Their breakthrough came with A Livingroom Hush, reissued internationally by Ninja Tune in 2002, followed by What We Must, One-Armed Bandit and Starfire. In 2020, Pyramid marked their debut on Flying Lotus’ Brainfeeder label, distilling their experimental practice into four long-form compositions. Their significance lies in this refusal to settle: each record reconsiders what an ensemble can be.",
      "ends_at": null,
      "image_url": "https://www.barbican.org.uk/sites/default/files/styles/event_listing_small_jpg/public/images/2026-08/JJ%20Atom%20Brussels%20liten%20%281%29.jpg?h=308ef9ea&itok=5nMkpDAr",
      "lat": 51.5201,
      "lng": -0.0955,
      "price": {
        "currency": "GBP",
        "is_free": false,
        "max": "29",
        "min": "29"
      },
      "starts_at": "2026-11-19T19:30:00Z",
      "tags": [
        "contemporary-music",
        "jazz"
      ],
      "title": "Jaga Jazzist",
      "url": "https://www.barbican.org.uk/whats-on/2026/event/jaga-jazzist",
      "venue_name": "Barbican Centre"
    },
    "id": "2026/jaga-jazzist",
    "payload": {
      "art_forms": [
        "contemporary-music"
      ],
      "date_text": "Thu 19 Nov 2026, 19:30",
      "description": "\n  <p>The Norwegian eight-piece bring four decades of restless experimentation to the EFG London Jazz Festival, where jazz, post-rock, psychedelia and electronic music converge.</p>\n\n<p>Founded in Norway in 1994 by the Horntveth siblings, Jaga Jazzist have spent four decades resisting genre orthodoxy. Led compositionally by <strong>Lars Horntveth</strong>, the eight-piece has developed a language spanning jazz, electronica, post-rock, psychedelia and cinematic composition, while retaining a fundamentally collaborative approach.</p><p>Their breakthrough came with <em>A Livingroom Hush</em>, reissued internationally by Ninja Tune in 2002, followed by <em>What We Must</em>, <em>One-Armed Bandit </em>and <em>Starfire</em>. In 2020, <em>Pyramid</em> marked their debut on Flying Lotus’ Brainfeeder label, distilling their experimental practice into four long-form compositions. Their significance lies in this refusal to settle: each record reconsiders what an ensemble can be.</p>",
      "ends": null,
      "image_url": "https://www.barbican.org.uk/sites/default/files/styles/event_listing_small_jpg/public/images/2026-08/JJ%20Atom%20Brussels%20liten%20%281%29.jpg?h=308ef9ea&itok=5nMkpDAr",
