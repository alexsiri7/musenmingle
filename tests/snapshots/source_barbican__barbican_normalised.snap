    "id": "2026/young-barbican-pick-mix-signal-decay-15",
    "payload": {
      "art_forms": [
        "talks-events",
        "take-part",
        "cinema"
      ],
      "date_text": "Thu 10 Dec 2026, 18:30",
      "description": "\n  <p><span lang=\"EN-GB\">Young Barbican Pick &amp; Mix presents </span><em><span lang=\"EN-GB\">Signal Decay</span></em><span lang=\"EN-GB\">, a screening of short films about moving through cities and finding the strange in the everyday.</span></p>\n\n<p>Pulling together disparate works from London to Dhaka, and Brooklyn to Sheffield, the films range from deadpan snapshots of city life to surreal night drives and poetic portraits of everyday living. Together, they capture the bleary-eyed sensation of finding something to watch at 2am, flicking past a channel you didn't know existed; a restless, unpolished transmission from the overlooked and off-kilter.</p><p><span lang=\"EN-GB\"></span></p><p><span lang=\"EN-GB\"></span></p><p><span lang=\"EN-GB\">Curated by London-based archivist and </span><a class=\"Hyperlink SCXW159605841 BCX0\" href=\"https://www.barbican.org.uk/take-part/young-creatives/barbican-young-film-programmers\"><span lang=\"EN-GB\">Barbican Young Film Programmers</span></a><span lang=\"EN-GB\"> alum, <strong>Raageh Ali</strong>.</span></p><p><span lang=\"EN-GB\"></span></p><p><span lang=\"EN-GB\"></span></p>",
      "ends": null,
      "image_url": "https://www.barbican.org.uk/sites/default/files/styles/event_listing_small_jpg/public/images/2026-08/HufflePuff%20Landscape%20still%20%28filmmaker%20approved%29%29.jpeg?itok=b8n5dWVa",
      "listing_title": "Young Barbican Pick & Mix: Signal Decay (15)",
      "price_text": null,
      "room": "Cinema 3",
      "series": [
        "young-barbican-events"
      ],
      "starts": "2026-12-10T18:30:00Z",
      "subtitle": "Young Barbican Events",
      "title": "Pick & Mix: Signal Decay (15)",
      "url": "https://www.barbican.org.uk/whats-on/2026/event/young-barbican-pick-mix-signal-decay-15"
    }
  },
