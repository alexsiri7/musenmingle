  {
    "date": "16 September 2026 - 20 December 2026",
    "event": {
      "address": "39a Canonbury Square, London N1 2AN",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "wanda-marion-wulz-avant-garde-photography-in-20th-century-italy|2026-09-16|estorick-collection",
      "description": "This September, the Estorick Collection presents a major exhibition exploring the pioneering work of sisters Wanda Wulz (1903–1984) and Marion Wulz (1905–1993), key figures in the development of avant-garde photography in 20th-century Italy. Organised in collaboration with the Fondazione Alinari per la Fotografia and with the support of Calliope Arts Foundation, the show also traces the wider legacy of the Wulz family, whose photographic practice spanned generations.",
      "ends_at": "2026-12-20T00:00:00Z",
      "image_url": null,
      "lat": 51.5437,
      "lng": -0.1003,
      "price": {
        "currency": null,
        "is_free": false,
