  {
    "date": "20 January 2027 - 13 June 2027",
    "event": {
      "address": "39a Canonbury Square, London N1 2AN",
      "all_day": true,
      "category": "exhibition",
      "dedupe_key": "carla-accardi|2027-01-20|estorick-collection",
      "description": "In January 2027, the first institutional presentation in the UK dedicated to the work of Carla Accardi (Trapani, 1924–Rome, 2014) will take place across the Estorick Collection, London, and Compton Verney, Warwickshire. This unprecedented collaboration between the two institutions will spotlight one of Italy’s most influential postwar artists with two landmark exhibitions on view simultaneously.",
