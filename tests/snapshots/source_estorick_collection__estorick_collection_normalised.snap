      ],
      "title": "Wanda and Marion Wulz: Avant-garde Photography in 20th-Century Italy",
      "url": "https://www.estorickcollection.com/exhibitions/wanda-and-marion-wulz-avant-garde-photography-in-20th-century-italy",
      "venue_name": "Estorick Collection"
    },
