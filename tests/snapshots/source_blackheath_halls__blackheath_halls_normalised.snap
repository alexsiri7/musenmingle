  {
    "date_text": "Thu 19 Nov, 8.00pm",
    "event": {
      "address": "23 Lee Road, London SE3 9RQ",
      "all_day": false,
      "category": "music",
      "dedupe_key": "emma-smith-evening-of-swing-celebration|2026-11-19|blackheath-halls",
      "description": "Peter Conway Promotions and Blackheath Halls present: Emma Smith – part of the EFG London Jazz Festival Experience one of the UK’s most captivating jazz performers as award-winning vocalist Emma Smith takes to the stage at Blackheath Halls for the first time. Celebrated for her rich, expressive voice and magnetic stage presence, Emma has become one of the leading names in contemporary jazz. Whether performing intimate ballads or exhilarating swing, she brings warmth, wit and extraordinary musicianship to every performance. Having appeared everywhere from the Royal Albert Hall to some of the world’s most iconic jazz clubs, Emma has shared the stage with artists including Michael Bublé, Jeff Goldblum, the Quincy Jones Orchestra and the Royal Philharmonic Orchestra. She is also a familiar face at legendary venues such as Ronnie Scott’s in London, Birdland in New York and Blue Note Milano, where her performances regularly sell out. Born into a family of jazz musicians, Emma’s love of the genre runs deep. Inspired by her grandfather, who performed alongside Frank Sinatra, Sammy Davis Jr. and Oscar Peterson, she combines a profound respect for the jazz tradition with a fresh, contemporary approach that has won audiences around the world. Her accolades include the Parliamentary Jazz Award for Jazz Vocalist of the Year and J azz Act of the Year at the Jools Holland Boisdale Music Awards. Alongside her acclaimed solo career, Emma has enjoyed the widespread success of her long-established vocal harmony group The Puppini Sisters and spent four years as a broadcaster on BBC Radio 3. Her most recent album Bitter Orange (released July 2025) met with widespread critical acclaim and multi-million streams. Expect an unforgettable evening of outstanding vocals, heartfelt interpretations and effortless swing from one of British jazz’s brightest stars. Whether you’re a lifelong jazz lover or discovering the genre for the first time, this promises to be a fantastic event. Sam Watts Piano Jack Tustin Double Bass Luke Tomlinson Drums part of the EFG London Jazz Festival",
      "ends_at": null,
      "image_url": "https://www.blackheathhalls.com/wp-content/uploads/2026/07/Emma-smith-394-x-220-px-1.png",
      "lat": null,
      "lng": null,
      "price": {
        "currency": "GBP",
        "is_free": false,
        "max": "50",
        "min": "30"
      },
      "starts_at": "2026-11-19T20:00:00Z",
      "tags": [
        "jazz",
        "music"
      ],
      "title": "Emma Smith: An Evening of Swing and Celebration",
      "url": "https://www.blackheathhalls.com/whats-on/emma-smith/",
      "venue_name": "Blackheath Halls"
    },
    "source_event_id": "emma-smith",
    "types": [
      "Jazz",
      "Music"
    ]
  },
