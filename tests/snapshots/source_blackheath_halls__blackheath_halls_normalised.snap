  {
    "date_text": "Tue 17 Nov, 7.00pm",
    "event": {
      "address": "23 Lee Road, London SE3 9RQ",
      "all_day": false,
      "category": "talk",
      "dedupe_key": "evening-with-sarah-raven-adam-nicolson|2026-11-17|blackheath-halls",
      "description": "Join Sarah Raven and Adam Nicolson for a rare evening together, sharing the inside story of two remarkable gardens – Sissinghurst Castle and Perch Hill – and the family, ideas and history that connect them. Adam grew up at Sissinghurst with his grandparents, Vita Sackville-West and Harold Nicolson. Vita was a celebrated writer and the creative force behind one of England’s most influential gardens; Harold an MP and writer who gave the garden its enduring structure. Adam and Sarah returned to Sissinghurst in 2004 with their young family, while just a few miles away Sarah continued to create the world-famous garden at Perch Hill. Together, Sarah and Adam will explore these two very different places: Sissinghurst, steeped in memory and nostalgia, and Perch Hill, colourful, experimental and always looking forward. Through their personal stories, you’ll discover how each garden has evolved, the people and ideas that have shaped them, and what gardens can give us in return. There will be a Sarah Raven pop-up shop, book signing and Q&A. Duration: 110 minutes including an interval",
      "ends_at": "2026-11-17T20:30:00Z",
      "image_url": "https://www.blackheathhalls.com/wp-content/uploads/2026/09/2026-394x220px-SR-AN-Blackheath-Halls.jpg",
      "lat": null,
      "lng": null,
      "price": {
        "currency": "GBP",
        "is_free": false,
        "max": "29",
        "min": "29"
      },
      "starts_at": "2026-11-17T19:00:00Z",
      "tags": [
        "talks"
      ],
      "title": "An Evening With Sarah Raven & Adam Nicolson",
      "url": "https://www.blackheathhalls.com/whats-on/an-evening-with-sarah-raven-adam-nicolson/",
      "venue_name": "Blackheath Halls"
    },
    "source_event_id": "an-evening-with-sarah-raven-adam-nicolson",
    "types": [
      "Talks"
    ]
