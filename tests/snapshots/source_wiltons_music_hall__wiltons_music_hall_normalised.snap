  {
    "event": {
      "address": "Graces Alley, London E1 8JB",
      "all_day": false,
      "category": "music",
      "dedupe_key": "steve-pretty-friends-on-origin-of-pieces|2027-03-10|wiltons-music",
      "description": "Are you musically curious? Why does a groove make us move? How do musicians from different traditions understand one another? Can a seashell become an instrument? Join musician, composer and Hackney Colliery Band leader Steve Pretty for a variety show that takes music apart and puts it back together live. Through performances, conversation, demonstrations and spontaneous collaborations, Steve and his guests explore where musical ideas come from, how they work and why they affect us. Previous live guests have included comedian Robin Ince, Pink Floyd bassist Guy Pratt, jazz star Theon Cross and Tony Award-winner Frances Ruffelle. Based on Steve’s podcast On the Origin of the Pieces ( “wide-ranging and insightful” — Guardian), the show roams across genres, cultures, science and the musical brain. No musical knowledge is required: whether you’re a seasoned musician or shower singer, you’ll leave with new ways to hear, understand and enjoy the music you love. With special guest Beardyman Joining Steve Pretty for an evening of music, chat and musical surprises is Beardyman : twice UK beatboxing champion, comedian and a pioneer of live looping. Using his voice and his own music-making technology, he creates tracks on the spot, combining extraordinary vocal skills with quick-thinking improvisation and humour. More guests to be announced. Weblinks: Podcast: www.originofthepieces.com Steve Pretty: www.stevepretty.com Hackney Colliery Band: www.hackneycollieryband.co.uk",
      "ends_at": "2027-03-10T21:30:00Z",
      "image_url": "https://wiltons.org.uk/wp-content/uploads/2026/09/OOTP-@-Wiltons-Jan-2024-3-edited-1-1024x552.png",
      "lat": null,
      "lng": null,
      "price": {
        "currency": "GBP",
        "is_free": false,
        "max": "20.00",
        "min": "7.50"
      },
      "starts_at": "2027-03-10T19:00:00Z",
      "tags": [],
      "title": "Steve Pretty (and Friends) On the Origin of the Pieces",
      "url": "https://wiltons.org.uk/whats-on/steve-pretty-and-friends-on-the-origin-of-the-pieces-3/",
      "venue_name": "Wilton's Music Hall"
    },
