# Copy to .env for local runs (never commit .env). The binaries read the process
# environment; load it with e.g. `set -a; . ./.env; set +a`.

# Postgres connection. In production: the restricted `musenmingle` role created by
# ops/sql/create-role.sql (Supabase session pooler or direct connection).
DATABASE_URL=postgres://musenmingle:change-me@localhost:5432/postgres

# Ticketmaster Discovery API key (https://developer.ticketmaster.com/).
# If unset, the ticketmaster source is skipped with a warning.
TICKETMASTER_API_KEY=

# GitHub token with Issues read/write on GITHUB_REPO, used by the health checker
# to open/close `scraper-broken` issues and to file `new-scraper` issues for site
# suggestions. If unset, health trips are only logged and suggestions stay pending.
GITHUB_TOKEN=
GITHUB_REPO=alexsiri7/musenmingle

# HTTP port for musenmingle-api (Railway injects PORT).
PORT=8080

# Site suggestions (musenmingle-api): secret salt for the stored client-IP hash
# (required by the API), per-IP limits, and how many reverse proxies in front of
# the API may be trusted for X-Forwarded-For (Railway: 1; 0 = TCP peer address).
SUGGESTION_IP_SALT=change-me
SUGGESTION_RATE_PER_HOUR=5
SUGGESTION_RATE_PER_DAY=20
TRUSTED_PROXY_COUNT=0

# Redirect requests for the old host (LEGACY_HOSTS, default
# thaleia.interstellarai.net) to this host. Unset in development: no redirect.
# CANONICAL_HOST=musenmingle.interstellarai.net

# Browser origins allowed to call musenmingle-api (CORS), comma-separated
# scheme://host[:port]. Unset = no cross-origin access.
CORS_ORIGINS=http://localhost:5173

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,musenmingle=debug

# Per-domain politeness: minimum milliseconds between two requests to the same
# host (default 2000 = 1 request / 2 s), plus optional per-host overrides.
# A robots.txt Crawl-delay larger than this always wins.
RATE_LIMIT_MS=2000
RATE_LIMIT_OVERRIDES=app.ticketmaster.com=500

# Per-source fetch timeout for musenmingle-ingest (seconds).
SOURCE_TIMEOUT_SECS=300

# AI enrichment + embeddings (musenmingle-ingest). Unset REQUESTY_API_KEY = off
# (events then carry only their sources' default medium tags).
# REQUESTY_API_KEY=
# ENRICH_MODEL=anthropic/claude-opus-5-5     # needs a zero-retention events.model_prices row
# ENRICH_DAILY_CAP_USD=1.00                   # all Requesty spend per London day
# ENRICH_RUN_CAP_USD=0.40                     # per ingest run
# ENRICH_BATCH_SIZE=10
# ENRICH_MAX_EVENTS_PER_RUN=120
# ENRICH_RUN_BUDGET_SECS=300
# ENRICH_OUTPUT_MODE=json_object              # or json_schema
# ENRICH_REASONING_EFFORT=low                 # "default" = don't send it
# EMBED_MODEL=openai/text-embedding-3-small   # "off" = no embeddings
# REQUESTY_BASE_URL=https://router.requesty.ai

# ntfy topic for owner alerts (e.g. Requesty credits exhausted); unset = logged.
# NTFY_TOPIC=
# NTFY_BASE_URL=https://ntfy.sh

# Tests only: any Postgres where the user may CREATE DATABASE.
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
