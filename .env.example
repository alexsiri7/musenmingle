# Copy to .env for local runs (never commit .env). The binaries read the process
# environment; load it with e.g. `set -a; . ./.env; set +a`.

# Postgres connection. In production: the restricted `thaleia` role created by
# ops/sql/create-role.sql (Supabase session pooler or direct connection).
DATABASE_URL=postgres://thaleia:change-me@localhost:5432/postgres

# Ticketmaster Discovery API key (https://developer.ticketmaster.com/).
# If unset, the ticketmaster source is skipped with a warning.
TICKETMASTER_API_KEY=

# GitHub token with Issues read/write on GITHUB_REPO, used by the health checker
# to open/close `scraper-broken` issues. If unset, health trips are only logged.
GITHUB_TOKEN=
GITHUB_REPO=alexsiri7/thaleia

# HTTP port for thaleia-api (Railway injects PORT).
PORT=8080

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,thaleia=debug

# Per-domain politeness: minimum milliseconds between two requests to the same
# host (default 2000 = 1 request / 2 s), plus optional per-host overrides.
# A robots.txt Crawl-delay larger than this always wins.
RATE_LIMIT_MS=2000
RATE_LIMIT_OVERRIDES=app.ticketmaster.com=500

# Per-source fetch timeout for thaleia-ingest (seconds).
SOURCE_TIMEOUT_SECS=300

# Tests only: any Postgres where the user may CREATE DATABASE.
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
